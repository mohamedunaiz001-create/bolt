# =========================
# BOLT — environment template
# =========================
# Copy this file to .env locally and fill only the values you actually use.
# NEVER commit .env or service-account credentials.

# ---------- Application ----------
BOLT_JWT_SECRET=
BOLT_ALLOW_TEST_TOKENS=false
ENABLE_DEV_CLI=false
BOLT_APP_URL=http://localhost:3000

# ---------- Firebase Admin / server ----------
FIREBASE_PROJECT_ID=bolt-87397
FIREBASE_SERVICE_ACCOUNT=
# Alternative to FIREBASE_SERVICE_ACCOUNT when using split credentials:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- Firebase Web / Vite ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bolt-87397.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bolt-87397
VITE_FIREBASE_STORAGE_BUCKET=bolt-87397.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------- AI providers ----------
ANTHROPIC_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# ---------- Local AI ----------
LOCAL_AI_ENDPOINT=
LOCAL_AI_MODEL=

# ---------- Storage / vector data ----------
VECTOR_DB_PATH=
