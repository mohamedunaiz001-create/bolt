rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'autumnr092006@gmail.com' ||
        request.auth.token.email == 'admin@bolt.internal' ||
        request.auth.token.email == 'admin@upsc-bolt.org'
      );
    }

    // User profiles and all user-private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Direct root collections partitioned by userId
    match /syllabus/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /progress/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /studyLogs/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mainsEvaluations/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /documents/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /chatHistory/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public / verified daily current affairs and published MCQs (read-only for students, admin-only write)
    match /current_affairs/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /daily_mcqs/{mcqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shared model registry versions (read-only for students, admin-only write)
    match /model_registry/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public curriculum Knowledge Graph (read-only for all students, admin-only write for updates)
    match /knowledge_nodes/{nodeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /knowledge_edges/{edgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /knowledge_clusters/{clusterId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
